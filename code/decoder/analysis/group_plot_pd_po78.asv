function GPD = group_plot_pd_po78(cacheFiles)
% cacheFiles = cellstr of subject cache .mat paths (each contains training1, training2, cfg)
% Returns struct with mean±SEM and per-subject traces.

nS = numel(cacheFiles);

PdPre  = [];
PdPost = [];
tvec   = [];

for i = 1:nS
    C = load(cacheFiles{i});  % has cfg, training1, training2
    cfg = C.cfg;

    % Need PO7/PO8 indices
    lIdx = find(ismember(cfg.chanLabels, {'PO7'}));
    rIdx = find(ismember(cfg.chanLabels, {'PO8'}));
    if isempty(lIdx) || isempty(rIdx)
        warning('PO7/PO8 not found for %s, skipping', C.subjectID);
        continue;
    end

    % Use your exact Pd definition
    Pd1 = local_compute_pd(C.training1.epochs, cfg, lIdx, rIdx);
    Pd2 = local_compute_pd(C.training2.epochs, cfg, lIdx, rIdx);

    if isempty(tvec)
        tvec = cfg.epochTime(:);
    end

    PdPre  = [PdPre;  Pd1(:)']; %#ok<AGROW>
    PdPost = [PdPost; Pd2(:)']; %#ok<AGROW>
end

mPre  = mean(PdPre,  1, 'omitnan');
mPost = mean(PdPost, 1, 'omitnan');
semPre  = std(PdPre, 0, 1, 'omitnan') ./ sqrt(sum(~isnan(PdPre(:,1)),1));
semPost = std(PdPost,0, 1, 'omitnan') ./ sqrt(sum(~isnan(PdPost(:,1)),1));

% ---- plot ----
figure('Color','w','Units','inches','Position',[1 1 4.5 4]); hold on;

patch([0.2 0.5 0.5 0.2], [-10 -10 10 10], [0.9 0.9 0.9], ...
    'EdgeColor','none','FaceAlpha',0.5,'HandleVisibility','off');

shaded_band(tvec, mPre,  semPre);
plot(tvec, mPre,  'LineWidth', 2);

shaded_band(tvec, mPost, semPost);
plot(tvec, mPost, 'LineWidth', 2);

xline(0,'-','LineWidth',1.2,'HandleVisibility','off');
yline(0,'-','LineWidth',1.2,'HandleVisibility','off');

xlim([-0.2 0.75]);
ylim([-4 4]);
xlabel('Time (s)');
ylabel('Amplitude (\muV)');
title(sprintf('Group Pd (contra–ipsi) at PO7/PO8 (n=%d)', size(PdPre,1)));
legend({'Pre SEM','Pre','Post SEM','Post'}, 'Location','northeast');
grid on; box off;

GPD = struct();
GPD.t = tvec;
GPD.PdPre  = PdPre;
GPD.PdPost = PdPost;
GPD.meanPre  = mPre;  GPD.meanPost = mPost;
GPD.semPre   = semPre; GPD.semPost = semPost;

end

function shaded_band(x, m, s)
x = x(:); m = m(:); s = s(:);
X = [x; flipud(x)];
Y = [m-s; flipud(m+s)];
patch(X, Y, 1, 'FaceAlpha',0.12,'EdgeColor','none');
end

function Pd = local_compute_pd(D, params, lIdx, rIdx)
bw = params.baseline_window;
bIdx = (params.epochTime >= bw(1)) & (params.epochTime <= bw(2));
baseline = mean(D.data(bIdx,:,:), 1);
data = D.data - baseline;

dTrialsR = (D.labels == 1);
dTrialsL = (D.labels == 2);

avgL_PO7 = squeeze(mean(mean(data(:, lIdx, dTrialsL), 2), 3));
avgR_PO7 = squeeze(mean(mean(data(:, lIdx, dTrialsR), 2), 3));
avgL_PO8 = squeeze(mean(mean(data(:, rIdx, dTrialsL), 2), 3));
avgR_PO8 = squeeze(mean(mean(data(:, rIdx, dTrialsR), 2), 3));

diffL = avgL_PO8 - avgL_PO7;
diffR = avgR_PO7 - avgR_PO8;

Pd = (diffL + diffR) / 2;
end
