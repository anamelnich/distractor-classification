function GT = group_plot_pd_topos(cacheFiles, chanlocs)


MAP_MAV_PRE  = [];
MAP_AUC_PRE  = [];
MAP_MAV_POST = [];
MAP_AUC_POST = [];

usedIDs = {};
paramsRef = [];
chanlocsOrdRef = [];
idxFoundRef = [];

for i = 1:numel(cacheFiles)

    try
        C = load(cacheFiles{i});
        % sanity: cache must be 64
        assert(numel(C.cfg.chanLabels) == 64, 'Cache %s: cfg.chanLabels is %d (expected 64).', cacheFiles{i}, numel(C.cfg.chanLabels));
        assert(size(C.training1.epochs.data,2) == 64, 'Cache %s: training1 epochs has %d chans (expected 64).', cacheFiles{i}, size(C.training1.epochs.data,2));


        if ~isfield(C,'training1') || ~isfield(C,'training2') || ~isfield(C,'cfg')
            continue;
        end

        if ~isfield(C.training1,'epochs') || isempty(C.training1.epochs)
            continue;
        end
        if ~isfield(C.training2,'epochs') || isempty(C.training2.epochs)
            continue;
        end

        % ----- PRE (training1) -----
        outPre  = computePdR2_pairDiffTopos(C.training1, C.cfg, chanlocs);
        outPost = computePdR2_pairDiffTopos(C.training2, C.cfg, chanlocs);

        if ~isfield(outPre,'map_combined_MAV') || ...
           ~isfield(outPost,'map_combined_MAV')
            continue;
        end

        vM_pre  = outPre.map_combined_MAV(:);
        vA_pre  = outPre.map_combined_AUC(:);
        vM_post = outPost.map_combined_MAV(:);
        vA_post = outPost.map_combined_AUC(:);

        nChan = numel(C.cfg.chanLabels);

        if numel(vM_pre) ~= nChan || numel(vM_post) ~= nChan
            continue;
        end

        MAP_MAV_PRE(:,end+1)  = vM_pre;   %#ok<AGROW>
        MAP_AUC_PRE(:,end+1)  = vA_pre;   %#ok<AGROW>
        MAP_MAV_POST(:,end+1) = vM_post;  %#ok<AGROW>
        MAP_AUC_POST(:,end+1) = vA_post;  %#ok<AGROW>

        usedIDs{end+1} = C.subjectID; %#ok<AGROW>

        % store ordering reference once
        if isempty(paramsRef)
            paramsRef = C.cfg;
            [chanlocsOrdRef, idxFoundRef] = ...
                local_reorder_chanlocs_by_labels(chanlocs, paramsRef.chanLabels);
        end

    catch
        continue;
    end
end

N = size(MAP_MAV_PRE,2);

if N == 0
    warning('No valid subjects found.');
    GT = struct('N',0);
    return;
end

% ----- GROUP MEANS -----
mMAV_pre  = mean(MAP_MAV_PRE,  2, 'omitnan');
mMAV_post = mean(MAP_MAV_POST, 2, 'omitnan');

mAUC_pre  = mean(MAP_AUC_PRE,  2, 'omitnan');
mAUC_post = mean(MAP_AUC_POST, 2, 'omitnan');

% ----- Apply your exact keep logic -----
keepM_pre  = ~isnan(idxFoundRef) & ~isnan(mMAV_pre);
keepM_post = ~isnan(idxFoundRef) & ~isnan(mMAV_post);

keepA_pre  = ~isnan(idxFoundRef) & ~isnan(mAUC_pre);
keepA_post = ~isnan(idxFoundRef) & ~isnan(mAUC_post);

plotArgs = {'electrodes','labels','plotrad',0.7,'headrad',0.50,'electcolor','w'};
fprintf('MAV: min=%.4g max=%.4g\n', min(mMAV_pre,[],'omitnan'), max(mMAV_pre,[],'omitnan'));

figure('Color','w','Units','inches','Position',[1 1 10 6]);

%% -------- MAV --------
subplot(2,2,1)
topoplot(mMAV_pre(keepM_pre), chanlocsOrdRef(keepM_pre), plotArgs{:});
colorbar;
title(sprintf('Pre (training1) – MAV (N=%d)', N));

subplot(2,2,2)
topoplot(mMAV_post(keepM_post), chanlocsOrdRef(keepM_post), plotArgs{:});
colorbar;
title(sprintf('Post (training2) – MAV (N=%d)', N));

%% -------- AUC --------
subplot(2,2,3)
topoplot(mAUC_pre(keepA_pre), chanlocsOrdRef(keepA_pre), plotArgs{:});
colorbar;
title('Pre – Positive AUC');

subplot(2,2,4)
topoplot(mAUC_post(keepA_post), chanlocsOrdRef(keepA_post), plotArgs{:});
colorbar;
title('Post – Positive AUC');

GT = struct();
GT.N = N;
GT.meanMAV_pre  = mMAV_pre;
GT.meanMAV_post = mMAV_post;
GT.meanAUC_pre  = mAUC_pre;
GT.meanAUC_post = mAUC_post;
GT.usedIDs = usedIDs;

end
function [chanlocs_ord, idxInChanlocs] = local_reorder_chanlocs_by_labels(chanlocs, chanLabels)
% Reorder chanlocs struct array to match chanLabels (case-insensitive).
% Returns:
%   chanlocs_ord     : 1 x nChan struct array in chanLabels order
%   idxInChanlocs    : nChan x 1 indices into original chanlocs (NaN if not found)

    nChan = numel(chanLabels);

    % preallocate (use first element as template)
    chanlocs_ord  = repmat(chanlocs(1), 1, nChan);
    idxInChanlocs = nan(nChan,1);

    clabs = upper(string(strtrim({chanlocs.labels})));

    for i = 1:nChan
        targ = upper(string(strtrim(chanLabels{i})));
        j = find(clabs == targ, 1, 'first');
        if ~isempty(j)
            chanlocs_ord(i)  = chanlocs(j);
            idxInChanlocs(i) = j;
        else
            idxInChanlocs(i) = nan;
        end
    end
end

