% subjects = {'e1','e2','e3','e4','e5','e6','e8','e13','e14','e15'};
subjects = {'e1','e2','e3','e4','e5','e6','e13'};
nSub     = numel(subjects);

% Preallocate a struct array with the right fields
results = struct( ...
    'subject',      cell(nSub,1), ...
    'performance',  cell(nSub,1), ...
    'modulation1',  cell(nSub,1), ...
    'modulation2',  cell(nSub,1)  ...
);

% Loop through and fill it
for i = 1:nSub
    subj = subjects{i};
    results(i).subject = subj;
    try
        [perf, mod1, mod2] = computeModel(subj);
        results(i).performance = perf;
        results(i).modulation1 = mod1;
        results(i).modulation2 = mod2;
    catch ME
        warning('Failed on %s: %s', subj, ME.message);
        % leave those cells empty if it crashes
    end
end

% Save everything in one .mat
save('decodingResultsFinal.mat','results');

%% Plot
% Parameters
S       = load('decodingResultsRetrainedTestTrain.mat','results');
results = S.results;
nSub         = numel(results);
sessionNames = {'Cal','Mod1','Mod2'};
nSess        = numel(sessionNames);
subjectLabels = {results.subject};

% Preallocate metric matrices
auprc_left  = nan(nSub,nSess);
auprc_right = nan(nSub,nSess);
acc_left    = nan(nSub,nSess);
acc_right   = nan(nSub,nSess);

% Extract data
for i = 1:nSub
    perf = results(i).performance;
    m1   = results(i).modulation1;
    m2   = results(i).modulation2;
    
    auprc_left(i,:)  = [perf.left.auprc,  m1.left.auprc,  m2.left.auprc];
    auprc_right(i,:) = [perf.right.auprc, m1.right.auprc, m2.right.auprc];
    
    acc_left(i,:)    = [perf.left.accuracy,  m1.left.accuracy,  m2.left.accuracy];
    acc_right(i,:)   = [perf.right.accuracy, m1.right.accuracy, m2.right.accuracy];
end

% Generate distinguishable colors and markers
colors  = hsv(nSub);  
markers = {'o','s','d','^','v','>','<','p','h','x'};  % 10 distinct markers

% Create figure
figure('Position',[100 100 900 650])
tiledlayout(2,2,'Padding','compact','TileSpacing','compact')

% 1) AUPRC — Left decoder
nexttile
hold on
for i = 1:nSub
    plot(1:nSess, auprc_left(i,:), ...
         'Color',           colors(i,:), ...
         'LineWidth',       1.2, ...
         'Marker',          markers{i}, ...
         'MarkerFaceColor', colors(i,:), ...
         'MarkerSize',      6);
end
plot(1:nSess, mean(auprc_left,1), '-k', 'LineWidth', 2.5);
set(gca, 'XTick', 1:nSess, 'XTickLabel', sessionNames)
xlabel('Session'), ylabel('AUPRC')
title('Left Decoder — AUPRC')
legend([subjectLabels, {'Mean'}], 'Location','eastoutside','FontSize',8)
hold off

% 2) AUPRC — Right decoder
nexttile
hold on
for i = 1:nSub
    plot(1:nSess, auprc_right(i,:), ...
         'Color',           colors(i,:), ...
         'LineWidth',       1.2, ...
         'Marker',          markers{i}, ...
         'MarkerFaceColor', colors(i,:), ...
         'MarkerSize',      6);
end
plot(1:nSess, mean(auprc_right,1), '-k', 'LineWidth', 2.5);
set(gca, 'XTick', 1:nSess, 'XTickLabel', sessionNames)
xlabel('Session')
title('Right Decoder — AUPRC')
legend([subjectLabels, {'Mean'}], 'Location','eastoutside','FontSize',8)
hold off

% 3) Accuracy — Left decoder
nexttile
hold on
for i = 1:nSub
    plot(1:nSess, acc_left(i,:), ...
         'Color',           colors(i,:), ...
         'LineWidth',       1.2, ...
         'Marker',          markers{i}, ...
         'MarkerFaceColor', colors(i,:), ...
         'MarkerSize',      6);
end
plot(1:nSess, mean(acc_left,1), '-k', 'LineWidth', 2.5);
set(gca, 'XTick', 1:nSess, 'XTickLabel', sessionNames)
xlabel('Session'), ylabel('Accuracy')
title('Left Decoder — Accuracy')
legend([subjectLabels, {'Mean'}], 'Location','eastoutside','FontSize',8)
hold off

% 4) Accuracy — Right decoder
nexttile
hold on
for i = 1:nSub
    plot(1:nSess, acc_right(i,:), ...
         'Color',           colors(i,:), ...
         'LineWidth',       1.2, ...
         'Marker',          markers{i}, ...
         'MarkerFaceColor', colors(i,:), ...
         'MarkerSize',      6);
end
plot(1:nSess, mean(acc_right,1), '-k', 'LineWidth', 2.5);
set(gca, 'XTick', 1:nSess, 'XTickLabel', sessionNames)
xlabel('Session')
title('Right Decoder — Accuracy')
legend([subjectLabels, {'Mean'}], 'Location','eastoutside','FontSize',8)
hold off

% Overall title
sgtitle('Decoder Performance Across Sessions','FontWeight','Bold')

